{
  "name": "gif-lab",
  "version": "1.0.0",
  "description": "Make transparent GIFs, stickers and emoji, and cut backgrounds out of stills. Runs entirely on your own machine.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "npm run build --silent && node dist-server/server/index.js",
    "check": "npm run build --silent && node dist-server/server/index.js --check",
    "dev": "vite"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^4.21.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "undici": "6.28.0",
    "nanoid@3.3.3": "3.3.18",
    "nanoid@4.0.2": "5.1.16"
  }
}
