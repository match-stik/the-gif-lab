# Never resolve a package version published less than a week ago. Every npm
# worm so far was caught and pulled within days, so a fresh resolution waits
# them out. npm ci from the lockfile is not affected: this guards new
# resolutions, npm install and npm update.
# To take one package sooner, add min-release-age-exclude=<name>.
min-release-age=7
